#!/usr/bin/env bash
# Récupération reproductible des bibliothèques du spike M7.6 (lsp4j).
# Les versions candidates : 1.0.0 (cible du client, LSP 3.18), 0.24.0
# (repli, LSP 3.17) et 0.23.1 (celle contre laquelle LemMinX 0.31.2 est
# construit). Gson 2.10.1 : la version déjà embarquée par le serveur,
# dans l'intervalle [2.9.1, 3.0) qu'exige lsp4j.jsonrpc — la preuve de
# la copie unique voudrait la même pour les deux bouts.
set -euo pipefail

ICI="$(cd "$(dirname "$0")" && pwd)"
LIBS="$ICI/libs"
mkdir -p "$LIBS"

BASE_CENTRAL="https://repo.maven.apache.org/maven2"
MIROIR="https://maven.aliyun.com/repository/central"

telecharger() { # telecharger <chemin-maven> <fichier-destination>
  curl -sL --fail --max-time 60 -o "$2" "$BASE_CENTRAL/$1" \
    || curl -sL --fail --max-time 60 -o "$2" "$MIROIR/$1"
  echo "  $(basename "$2")"
}

for version in 1.0.0 0.24.0 0.23.1; do
  telecharger "org/eclipse/lsp4j/org.eclipse.lsp4j/$version/org.eclipse.lsp4j-$version.jar" \
    "$LIBS/lsp4j-$version.jar"
  telecharger "org/eclipse/lsp4j/org.eclipse.lsp4j.jsonrpc/$version/org.eclipse.lsp4j.jsonrpc-$version.jar" \
    "$LIBS/lsp4j-jsonrpc-$version.jar"
done
telecharger "com/google/code/gson/gson/2.10.1/gson-2.10.1.jar" "$LIBS/gson-2.10.1.jar"

echo "bibliothèques du spike lsp4j en place : $LIBS"
