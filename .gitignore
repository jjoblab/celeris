# Sorties de build (jamais versionnées)
build/
out/
classes/
*.class
*.jar
*.aar
# Le jar du wrapper Gradle est versionné (wrapper autosuffisant, ADR-001)
!gradle/wrapper/gradle-wrapper.jar
# Le serveur tiers retiré embarqué dans la démonstration (M8.6,
# [EXT-6] — découpe reproductible par scripts/decoupe-serveur-retire)
!demo/libs/serveur-retire.jar
*.hprof

# Environnements et IDE
.gradle/
.idea/
*.iml
local.properties
.DS_Store

# Spikes : seul le code source est versionné, jamais les classes produites
spikes/**/out/
