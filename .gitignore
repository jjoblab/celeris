# Sorties de build (jamais versionnées)
build/
out/
classes/
*.class
*.jar
*.aar
# Le jar du wrapper Gradle est versionné (wrapper autosuffisant, ADR-001)
!gradle/wrapper/gradle-wrapper.jar
*.hprof

# Environnements et IDE
.gradle/
.idea/
*.iml
local.properties
.DS_Store

# La base de données du moteur de propriétés (jqwik) naît à la racine
# du module au premier passage des tests — artefact de banc, jamais versionné
.jqwik-database

# Spikes : seul le code source est versionné, jamais les classes produites
spikes/**/out/

# Spike M7.6 (moteur d'expressions rationnelles) : grammaires et
# bibliothèques téléchargées à la mesure, jamais versionnées — le
# script recuperer-grammaires les ramène de façon reproductible.
spikes/regex/grammaires/
spikes/regex/libs/
spikes/treesitter/sources/
spikes/treesitter/out/
