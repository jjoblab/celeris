<?xml version="1.0" encoding="utf-8"?>
<!--
  La vue d'un onglet : le nom du fichier et sa croix de fermeture.
  TabLayout pose cette vue par setCustomView ; le clic sur la croix
  ferme l'onglet SANS l'activer (le contenu reste celui de l'onglet
  actif courant).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/nom_onglet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="120dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/croix_onglet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:padding="4dp"
        android:text="✕"
        android:textSize="12sp" />
</LinearLayout>
