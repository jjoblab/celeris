<?xml version="1.0" encoding="utf-8"?>
<!--
  La scène de l'exemple — le retour terrain du 2026-11-19 :
  « utiliser de vrais layout pour le demo, qu'il soit plus
  moderne ». TOUT le chrome vit ici, en XML Material 3 :

  - DrawerLayout : le tiroir gauche glisse par-dessus la scène ;
  - NavigationView : les échantillons du dépôt (menu au code) ;
  - MaterialToolbar : le hamburger ouvre le tiroir, le titre suit
    l'onglet actif ;
  - TabLayout : les fichiers ouverts, défilables, fermables (la
    croix vit dans la vue d'onglet posée au code) ;
  - la scène : EditorView + PopupLayer du kit (§ 4.1 d'USAGE),
    gonflés par leur constructeur XML ;
  - le journal : panneau bas repliable, en-têtetitre + boutons.

  L'activité ne monte PLUS aucune vue à la main : elle gonfle,
  branche, vit.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tiroir_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_nuit">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/fond_surfacique"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/barre_outils"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/fond_surfacique"
                app:navigationIcon="@drawable/icone_tiroir"
                app:navigationContentDescription="@string/action_ouvrir_tiroir"
                app:title="@string/app_name"
                app:titleTextColor="@color/texte_principal" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/barre_onglets"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/fond_surfacique"
                app:tabBackground="@color/fond_surfacique"
                app:tabIndicatorColor="@color/accent_cyan"
                app:tabIndicatorHeight="2dp"
                app:tabGravity="start"
                app:tabMode="scrollable"
                app:tabMaxWidth="180dp"
                app:tabRippleColor="@color/accent_cyan"
                app:tabTextAppearance="@style/Texte.Onglet"
                app:tabTextColor="@color/texte_secondaire"
                app:tabSelectedTextColor="@color/accent_cyan_clair" />
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:id="@+id/scene"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/fond_nuit">

            <jo.celeris.android.view.EditorView
                android:id="@+id/vue_editeur"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <jo.celeris.android.widgets.PopupLayer
                android:id="@+id/couche_popups"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/panneau_journal"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:orientation="vertical"
            android:background="@color/fond_surfacique">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/titre_journal"
                    android:textColor="@color/accent_cyan_clair"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/bouton_copier_journal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icone_copier"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_copier" />

                <ImageButton
                    android:id="@+id/bouton_replier_journal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icone_replier"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_replier" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/defileur_journal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/lignes_journal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    style="@style/Texte.Journal" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/tiroir_navigation"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/fond_tiroir"
        app:headerLayout="@layout/entete_tiroir"
        app:menu="@menu/menu_tiroir"
        app:itemTextColor="@color/texte_principal"
        app:itemIconTint="@color/accent_cyan_clair" />
</androidx.drawerlayout.widget.DrawerLayout>
