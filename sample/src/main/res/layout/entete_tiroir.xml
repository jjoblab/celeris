<?xml version="1.0" encoding="utf-8"?>
<!-- L'en-tête du tiroir modernisé : le nom de l'exemple en typographie
     d'éditeur (monospace gras), le sous-titre dit ce que le tiroir
     porte — la ligne accent sépare de la liste. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/fond_tiroir"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/nom_entete_tiroir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/accent_cyan_clair"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/sous_titre_entete_tiroir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/version_tiroir"
        android:textColor="@color/texte_secondaire"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/contour_discret" />
</LinearLayout>
