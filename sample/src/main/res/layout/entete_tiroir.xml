<?xml version="1.0" encoding="utf-8"?>
<!-- L'en-tête du tiroir : le titre « Échantillons » sur la couleur
     du tiroir, séparé de la liste par le contour discret. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/fond_tiroir"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titre_tiroir"
        android:textColor="@color/accent_cyan_clair"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/contour_discret" />
</LinearLayout>
