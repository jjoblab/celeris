{
  "id": "kts",
  "name": "Kotlin Script",
  "extensions": [
    ".kts"
  ],
  "badge": "Ks",
  "badgeColor": "#7FDBCA",
  "syntax": {
    "preferred": "handwritten"
  },
  "parent": "kotlin",
  "filenamePatterns": [
    "*.gradle.kts"
  ],
  "comments": {
    "lineComment": "// ",
    "blockComment": [
      "/* ",
      " */"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")",
      "notIn": []
    },
    {
      "open": "[",
      "close": "]",
      "notIn": []
    },
    {
      "open": "{",
      "close": "}",
      "notIn": []
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ]
}
