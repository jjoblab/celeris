{
  "id": "python",
  "name": "Python",
  "extensions": [
    ".py",
    ".pyw"
  ],
  "badge": "Py",
  "badgeColor": "#82AAFF",
  "syntax": {
    "preferred": "tree-sitter",
    "fallback": "grammar"
  },
  "firstLine": "^#!.*python",
  "comments": {
    "lineComment": "# "
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")",
      "notIn": []
    },
    {
      "open": "[",
      "close": "]",
      "notIn": []
    },
    {
      "open": "{",
      "close": "}",
      "notIn": []
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "folding": {
    "byIndentation": true,
    "offSide": true
  }
}
