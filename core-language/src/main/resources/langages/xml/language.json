{
  "id": "xml",
  "name": "XML",
  "extensions": [
    ".xml"
  ],
  "badge": "Xm",
  "badgeColor": "#B0BEC5",
  "syntax": {
    "preferred": "handwritten"
  },
  "comments": {
    "blockComment": [
      "<!--",
      "-->"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")",
      "notIn": []
    },
    {
      "open": "[",
      "close": "]",
      "notIn": []
    },
    {
      "open": "{",
      "close": "}",
      "notIn": []
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ]
}
