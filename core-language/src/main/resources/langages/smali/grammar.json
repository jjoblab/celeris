{
  "name": "Smali",
  "scopeName": "source.smali",
  "patterns": [
    {
      "include": "#commentaires"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#inconnues"
    },
    {
      "include": "#registres"
    },
    {
      "include": "#chaines"
    },
    {
      "include": "#descripteurs"
    },
    {
      "include": "#nombres"
    },
    {
      "include": "#opcodes"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operateurs"
    },
    {
      "include": "#ponctuation"
    }
  ],
  "repository": {
    "commentaires": {
      "patterns": [
        {
          "match": "#[^\\n]*",
          "name": "comment.line.number-sign.smali"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "\\.end[ \\t]+(?:method|annotation|array-data|packed-switch|sparse-switch)\\b",
          "name": "keyword.other.directive.smali"
        },
        {
          "match": "\\.(?:class|super|source|implements|field|method|registers|locals|prologue|line|param|parameter|annotation|enum|array-data|packed-switch|sparse-switch|subannotation|catch|catchall)\\b",
          "name": "keyword.other.directive.smali"
        }
      ]
    },
    "inconnues": {
      "patterns": [
        {
          "match": "\\.[A-Za-z_][A-Za-z0-9_-]*",
          "name": "meta.annotation.unknown.smali"
        }
      ]
    },
    "registres": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_])(?:v1[0-5]|v[0-9]|p[0-9])(?![0-9A-Za-z_])",
          "name": "constant.other.register.smali"
        }
      ]
    },
    "chaines": {
      "patterns": [
        {
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "name": "string.quoted.double.smali"
        }
      ]
    },
    "descripteurs": {
      "patterns": [
        {
          "match": "\\[*L[^;\\n]{1,199};",
          "name": "entity.name.type.descriptor.smali"
        }
      ]
    },
    "nombres": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9a-fA-F]+\\b",
          "name": "constant.numeric.hex.smali"
        },
        {
          "match": "(?<![A-Za-z0-9_.])[+-]?\\d+(?:[tLl])?(?![A-Za-z0-9_])",
          "name": "constant.numeric.smali"
        }
      ]
    },
    "opcodes": {
      "patterns": [
        {
          "match": "\\b\\w+(?:\\-\\w+)+(?:\\/\\w+)+",
          "name": "storage.type.opcode.smali"
        },
        {
          "match": "\\b\\w+(?:\\-\\w+)+",
          "name": "storage.type.opcode.smali"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.smali"
        }
      ]
    },
    "operateurs": {
      "patterns": [
        {
          "match": "[+\\-*/%=!<>&|^~?:]",
          "name": "keyword.operator.smali"
        }
      ]
    },
    "ponctuation": {
      "patterns": [
        {
          "match": "[,;]",
          "name": "punctuation.separator.smali"
        },
        {
          "match": "[()\\[\\]{}]",
          "name": "punctuation.section.smali"
        }
      ]
    }
  }
}
