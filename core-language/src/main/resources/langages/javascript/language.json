{
  "id": "javascript",
  "name": "JavaScript",
  "extensions": [
    ".js",
    ".jsx",
    ".mjs",
    ".cjs"
  ],
  "badge": "Js",
  "badgeColor": "#F0DB4F",
  "syntax": {
    "preferred": "grammar"
  },
  "firstLine": "^#!.*\\bnode\\b",
  "comments": {
    "lineComment": "// ",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}",
      "notIn": []
    },
    {
      "open": "[",
      "close": "]",
      "notIn": []
    },
    {
      "open": "(",
      "close": ")",
      "notIn": []
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "'",
      "'"
    ],
    [
      "\"",
      "\""
    ],
    [
      "`",
      "`"
    ]
  ],
  "indentSize": 2
}
