#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Tests du contrôle des références interdites (scripts/check-forbidden-refs).

Le prompt M7.6 exige quatre cas : motif trouvé, motif absent, variable
vide, motif invalide. Les motifs des tests sont des mots factices — les
véritables motifs interdits ne se committent jamais (règle 7).

Usage :  python3 scripts/test-check-forbidden-refs
"""

import os
import subprocess
import sys
import tempfile
import unittest

SCRIPT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "check-forbidden-refs")


def lancer(motifs: str, extra: str = "") -> subprocess.CompletedProcess:
    """Exécute le contrôle dans un répertoire de travail sans .git."""
    env = {
        "PATH": os.environ.get("PATH", "/usr/bin"),
        "HOME": os.environ.get("HOME", "/tmp"),
    }
    if motifs:
        env["CELERIS_FORBIDDEN_REFS"] = motifs
    if extra:
        env["FORBIDDEN_REFS_EXTRA"] = extra
    return subprocess.run(
        [sys.executable, SCRIPT],
        capture_output=True,
        text=True,
        env=env,
        timeout=30,
    )


class Fixture:
    """Répertoire de travail temporaire avec des fichiers fictifs."""

    def __enter__(self):
        self.dossier = tempfile.mkdtemp(prefix="celeris-refs-")
        self.ancien_cwd = os.getcwd()
        os.chdir(self.dossier)
        return self.dossier

    def __exit__(self, *args):
        os.chdir(self.ancien_cwd)


class ControleRefsTest(unittest.TestCase):
    """Les quatre cas exigés par le prompt M7.6, plus les exonérations."""

    def setUp(self):
        self.fixture = Fixture()
        self.dossier = self.fixture.__enter__()
        with open(os.path.join(self.dossier, "prose.md"), "w", encoding="utf-8") as fh:
            fh.write("Une ligne honnête.\nUne ligne sans histoire.\nDernière ligne.\n")

    def citerZorblax(self):
        """Ajoute au fichier de prose la mention qui doit être interdite."""
        with open(os.path.join(self.dossier, "prose.md"), "a", encoding="utf-8") as fh:
            fh.write("Une ligne qui cite zorblax au milieu.\n")

    def tearDown(self):
        self.fixture.__exit__(None, None, None)

    def test_motif_trouve(self):
        """Motif présent dans un fichier versionné : échec (code 1) et localisation."""
        self.citerZorblax()
        resultat = lancer("zorblax")
        self.assertEqual(resultat.returncode, 1, resultat.stdout + resultat.stderr)
        self.assertIn("motif interdit", resultat.stdout)
        self.assertIn("prose.md:4", resultat.stdout)

    def test_motif_absent(self):
        """Motif absent des fichiers : succès (code 0)."""
        resultat = lancer("introuvableparlohonneur")
        self.assertEqual(resultat.returncode, 0, resultat.stdout + resultat.stderr)
        self.assertIn("0 problème", resultat.stdout)

    def test_variable_vide(self):
        """Aucune variable de motifs définie : succès (code 0) et avertissement explicite."""
        resultat = lancer("")
        self.assertEqual(resultat.returncode, 0, resultat.stdout + resultat.stderr)
        self.assertIn("CELERIS_FORBIDDEN_REFS absente", resultat.stdout)

    def test_motif_invalide(self):
        """Motif qui n'est pas une expression rationnelle valide : échec (code 2)."""
        resultat = lancer("[nonfermee")
        self.assertEqual(resultat.returncode, 2, resultat.stdout + resultat.stderr)
        self.assertIn("motif invalide", resultat.stderr)

    def test_casse_indifferente(self):
        """Les motifs sont insensibles à la casse."""
        self.citerZorblax()
        resultat = lancer("ZORBLAX")
        self.assertEqual(resultat.returncode, 1, resultat.stdout + resultat.stderr)

    def test_extra_cumulatif(self):
        """FORBIDDEN_REFS_EXTRA s'ajoute aux motifs du secret."""
        self.citerZorblax()
        resultat = lancer("introuvableparlohonneur", extra="zorblax")
        self.assertEqual(resultat.returncode, 1, resultat.stdout + resultat.stderr)

    def test_fichier_de_build_exonere(self):
        """Les fichiers de build nomment légitimement les dépendances : exonérés."""
        with open(os.path.join(self.dossier, "build.gradle.kts"), "w", encoding="utf-8") as fh:
            fh.write('implementation("io.zorblax:zorblax-core:1.0")\n')
        resultat = lancer("zorblax")
        self.assertEqual(resultat.returncode, 0, resultat.stdout + resultat.stderr)

    def test_notice_exoneree(self):
        """NOTICE nomme les dépendances déclarées : exonéré."""
        with open(os.path.join(self.dossier, "NOTICE"), "w", encoding="utf-8") as fh:
            fh.write("| zorblax | 1.0 | MIT | démonstration |\n")
        resultat = lancer("zorblax")
        self.assertEqual(resultat.returncode, 0, resultat.stdout + resultat.stderr)


if __name__ == "__main__":
    unittest.main(verbosity=2)
