#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Contrôle de la politique de langue du dépôt.

Vérifie, sur tous les fichiers versionnés :
  1. identifiants non ASCII dans le code Java (hors commentaires et chaînes) ;
  2. typographie française des fichiers Markdown (espace insécable avant
     « ; », « : », « ! », « ? ») ;
  3. présence d'une Javadoc pour les classes publiques des sources et spikes ;
  4. parité des CHAÎNES AFFICHÉES entre values/ et values-fr/ (ADR-008 :
     les fichiers sans élément traduisible — identifiants, couleurs, thèmes
     — restent hors du contrôle ; les fichiers qui portent des chaînes,
     tableaux ou plurals doivent exister en français ET y déclarer chaque
     nom — la parité se mesure aux noms, pas à la seule existence).

Usage :  python3 scripts/check-language-policy [--fix]
Le mode --fix corrige la typographie (2) ; tout le reste échoue.
"""

import argparse
import os
import re
import subprocess
import sys

NON_BREAKING = {
    ";": "\u202f",
    ":": "\u00a0",
    "!": "\u202f",
    "?": "\u202f",
}


def git_files() -> list:
    out = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard"],
        capture_output=True, text=True,
    )  # fichiers suivis ET non suivis non ignorés : un fichier tout
    # nouveau ne doit pas échapper au contrôle avant son premier commit
    return [f for f in out.stdout.splitlines() if f.strip()]


def strip_java_comments_and_strings(text: str) -> str:
    """Retire commentaires et chaînes pour ne garder que le code.

    Les blocs de texte Java (triple guillemet) portent du contenu factice
    accentué dans les corpus de test — leur contenu s'ignore comme une
    chaîne, jusqu'au délimiteur fermant non échappé.
    """
    out = []
    i, n = 0, len(text)
    state = "code"
    while i < n:
        c = text[i]
        nxt = text[i + 1] if i + 1 < n else ""
        if state == "code":
            if c == "/" and nxt == "/":
                state = "line"
                i += 2
                continue
            if c == "/" and nxt == "*":
                state = "block"
                i += 2
                continue
            if text[i:i + 3] == '"""':
                state = "textblock"
                i += 3
                continue
            if c == '"':
                state = "string"
                i += 1
                continue
            out.append(c)
        elif state == "line":
            if c == "\n":
                state = "code"
                out.append(c)
        elif state == "block":
            if c == "*" and nxt == "/":
                state = "code"
                i += 2
                continue
        elif state == "textblock":
            if text[i:i + 3] == '"""':
                state = "code"
                i += 3
                continue
            if c == "\\":
                i += 2
                continue
        elif state == "string":
            if c == "\\":
                i += 2
                continue
            if c == '"':
                state = "code"
        i += 1
    return "".join(out)


def check_java_identifiers(path: str) -> list:
    """Signale tout caractère non ASCII hors commentaires et chaînes."""
    problems = []
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except (OSError, UnicodeDecodeError):
        return problems
    code = strip_java_comments_and_strings(text)
    for m in re.finditer(r"[^\x00-\x7f]", code):
        line = code.count("\n", 0, m.start()) + 1
        problems.append(f"{path}:{line}: caractère non ASCII dans le code")
    return problems


def check_typography(path: str, fix: bool) -> list:
    """Vérifie (ou corrige) l'espace insécable avant ; : ! ? en Markdown."""
    problems = []
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except (OSError, UnicodeDecodeError):
        return problems
    pattern = re.compile(r"(?<=[^\s`]) ([;:!?])(?=[\s\u00a0\u202f]|$)")
    hits = list(pattern.finditer(text))
    if not hits:
        return problems
    if fix:
        fixed = pattern.sub(lambda m: NON_BREAKING[m.group(1)] + m.group(1), text)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(fixed)
        return problems
    for m in hits:
        line = text.count("\n", 0, m.start()) + 1
        problems.append(
            f"{path}:{line}: espace sécable avant « {m.group(1)} » "
            "(utiliser une espace insécable)"
        )
    return problems


def check_javadoc(path: str) -> list:
    """Exige une Javadoc au-dessus de chaque classe publique.

    Les blocs de texte Java (\"\"\") portent souvent du code factice dans
    les tests — leurs lignes ne sont pas des déclarations, la recherche
    les ignore. Un nombre impair de délimiteurs sur une ligne bascule
    l'état d'ouverture, la ligne qui bascule n'est jamais une déclaration.
    """
    problems = []
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.readlines()
    except OSError:
        return problems
    en_bloc = False
    for i, line in enumerate(lines):
        if line.count('"""') % 2 == 1:
            en_bloc = not en_bloc
            continue
        if en_bloc or '"""' in line:
            continue
        if re.search(r"^\s*public\s+(final\s+)?(abstract\s+)?(class|interface|enum|record)\s", line):
            j = i - 1
            # Les annotations se placent entre la Javadoc et la déclaration :
            # les traverser — y compris leurs arguments multi-lignes — avant
            # de chercher la Javadoc.
            profondeur = 0
            while j >= 0:
                extrait = lines[j].strip()
                if profondeur > 0:
                    profondeur += extrait.count("(") - extrait.count(")")
                    j -= 1
                    continue
                if extrait.startswith("@"):
                    delta = extrait.count("(") - extrait.count(")")
                    if delta > 0:
                        profondeur = delta
                    j -= 1
                    continue
                break
            has_doc = False
            while j >= 0 and lines[j].strip().startswith(("*", "/*", "/**", "*/")):
                if "/**" in lines[j]:
                    has_doc = True
                j -= 1
            if not has_doc:
                problems.append(f"{path}:{i + 1}: classe publique sans Javadoc")
    return problems


# Élément d'un fichier de ressources qui porte du texte affichable :
# seule cette matière se traduit (ADR-008) — identifiants, couleurs et
# thèmes ne changent jamais de langue.
TRADUISIBLE = re.compile(r"<(?:string|string-array|plurals)\b")
NOM_RESSOURCE = re.compile(
    r"<(?:string|string-array|plurals)\b[^>]*?name=\"([^\"]+)\"")


def noms_ressources(text: str) -> set:
    """Les noms de chaînes, tableaux et plurals déclarés dans le texte."""
    return set(NOM_RESSOURCE.findall(text))


def check_string_parity() -> list:
    """Vérifie la parité des chaînes affichées values/ ↔ values-fr/."""
    problems = []
    if not os.path.isdir("demo/src/main/res/values"):
        return problems  # aucune ressource à M0 : contrôle inactif
    for module in ["demo", "android-view", "android-widgets", "android-host"]:
        base = os.path.join(module, "src/main/res")
        if not os.path.isdir(os.path.join(base, "values")):
            continue
        for name in sorted(os.listdir(os.path.join(base, "values"))):
            if not name.endswith(".xml"):
                continue
            chemin_defaut = os.path.join(base, "values", name)
            try:
                with open(chemin_defaut, encoding="utf-8") as fh:
                    defaut = fh.read()
            except (OSError, UnicodeDecodeError):
                problems.append(f"{module}: values/{name} illisible")
                continue
            if not TRADUISIBLE.search(defaut):
                continue  # rien de traduisible : la locale n'y change rien
            chemin_fr = os.path.join(base, "values-fr", name)
            try:
                with open(chemin_fr, encoding="utf-8") as fh:
                    francais = fh.read()
            except (OSError, UnicodeDecodeError):
                problems.append(f"{module}: values-fr/{name} manquant")
                continue
            for nom in sorted(noms_ressources(defaut) - noms_ressources(francais)):
                problems.append(
                    f"{module}: values-fr/{name} : « {nom} » sans traduction")
            for nom in sorted(noms_ressources(francais) - noms_ressources(defaut)):
                problems.append(
                    f"{module}: values-fr/{name} : « {nom} » sans ressource par défaut")
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(description="Politique de langue")
    parser.add_argument("--fix", action="store_true", help="corrige la typographie")
    args = parser.parse_args()

    files = git_files() if os.path.isdir(".git") else []
    if not files:
        for root, _dirs, names in os.walk("."):
            if "/.git" in root or "/.gradle" in root:
                continue
            files.extend(os.path.join(root, n) for n in names)

    problems = []
    for f in files:
        if f.endswith(".java"):
            problems += check_java_identifiers(f)
            problems += check_javadoc(f)
        elif f.endswith(".md"):
            problems += check_typography(f, args.fix)
    problems += check_string_parity()

    if args.fix and not problems:
        print("politique de langue : typographie corrigée, aucun autre problème")
        return 0
    for p in problems:
        print(p)
    print(f"politique de langue : {len(problems)} problème(s)")
    return 1 if problems else 0


if __name__ == "__main__":
    raise SystemExit(main())
