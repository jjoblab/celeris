#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Contrôle des références interdites (M7.6, nouvelle règle).

Depuis M7.6, les projets, IDE, éditeurs, bibliothèques, normes et
formats se nomment librement dans la documentation, les ADR, la
Javadoc, la matrice et le changelog — une mention est factuelle et
sourcée (lien ou version), une dépendance ou donnée reprise porte sa
licence. Deux projets restent interdits sans exception (règle 7 du
jalon) : eux-mêmes, leurs artefacts et tout ce que publient leurs
organisations ou leurs auteurs.

Les motifs nominatifs (expressions rationnelles séparées par « ; »,
insensibles à la casse) sont lus dans la variable d'environnement
CELERIS_FORBIDDEN_REFS (secret de CI) et FORBIDDEN_REFS_EXTRA (idem,
cumulatif, usage local) : **aucun motif ne se committe dans ce
dépôt**. Sans motif défini, le contrôle le dit et rend zéro — la CI,
elle, définit toujours les motifs comme secret.

Usage :  python3 scripts/check-forbidden-refs [chemins...]
"""

import os
import re
import subprocess
import sys

# Les fichiers de build et de conformité nomment légitimement les
# dépendances déclarées (coordonnées, licences) : ils échappent au
# balayage des motifs.
EXEMPT_SUFFIXES = ("build.gradle.kts", "settings.gradle.kts",
                   "libs.versions.toml", "NOTICE", "LICENSE")

# Le présent script définit la mécanique du contrôle (auto-référence).
EXEMPT_FILES = {"scripts/check-forbidden-refs", "scripts/check-dependency-provenance"}


def git_files() -> list:
    out = subprocess.run(["git", "ls-files"], capture_output=True, text=True)
    return [f for f in out.stdout.splitlines() if f.strip()]


def forbidden_patterns() -> list:
    env = os.environ.get("CELERIS_FORBIDDEN_REFS", "")
    extra = os.environ.get("FORBIDDEN_REFS_EXTRA", "")
    combined = f"{env};{extra}" if env and extra else (env or extra)
    return [p for p in combined.split(";") if p.strip()]


def collect_files() -> list:
    files = git_files() if os.path.isdir(".git") else []
    if not files:
        for root, _dirs, names in os.walk("."):
            if "/.git" in root or "/.gradle" in root:
                continue
            files.extend(os.path.join(root, n) for n in names)
    files = [f for f in files if not f.endswith(EXEMPT_SUFFIXES)]
    files = [f.removeprefix("./") for f in files]
    files = [f for f in files if f not in EXEMPT_FILES]
    return files


def main() -> int:
    patterns = forbidden_patterns()
    if not patterns:
        print(
            "avertissement : CELERIS_FORBIDDEN_REFS absente — aucun motif "
            "n'est appliqué (la CI doit définir la variable comme secret ; "
            "voir la règle 7 du jalon M7.6)"
        )
        return 0

    compiled = []
    for p in patterns:
        try:
            compiled.append((p, re.compile(p, re.IGNORECASE)))
        except re.error as err:
            print(f"motif invalide dans CELERIS_FORBIDDEN_REFS : {err}", file=sys.stderr)
            return 2

    problems = []
    for f in collect_files():
        try:
            with open(f, encoding="utf-8") as fh:
                text = fh.read()
        except (OSError, UnicodeDecodeError):
            continue
        for source, rx in compiled:
            for m in rx.finditer(text):
                line = text.count("\n", 0, m.start()) + 1
                problems.append(
                    f"{f}:{line}: motif interdit « {m.group(0)} » "
                    f"(motif « {source} »)"
                )

    for p in problems:
        print(p)
    print(f"références interdites : {len(problems)} problème(s)")
    return 1 if problems else 0


if __name__ == "__main__":
    raise SystemExit(main())
