<?xml version="1.0" encoding="utf-8"?>
<!-- Une carte de fichier d'exemple : monogramme de langage teinté à
     l'exécution (AdaptateurFichiers), nom en police à chasse fixe,
     langage et compte de lignes en sous-titre. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="10dp"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_contenant_bas"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/monogramme"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/fond_monogramme"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/encre"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nom_fichier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:textColor="@color/encre"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sous_titre_fichier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/encre_douce"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_suivant"
            app:tint="@color/contour" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
