<?xml version="1.0" encoding="utf-8"?>
<!-- Le contenu de la feuille de l'aller à (ADR-018, catégorie C de
     l'inventaire — « Go to File / Class / Symbol ») : le champ tape
     quelques lettres, la recherche floue répond — les résultats s'y
     rendent en rangées cliquables. Le champ tient le focus
     (PIEGE-27 ne concerne pas la feuille : elle vit hors de la
     couche). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundColor="@color/surface_variante"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_recherche">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/champ_aller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/indication_aller"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <ScrollView
        android:id="@+id/resultats_aller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxHeight="320dp">

        <LinearLayout
            android:id="@+id/rangees_aller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
