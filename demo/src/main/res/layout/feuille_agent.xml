<?xml version="1.0" encoding="utf-8"?>
<!-- Le contenu de la feuille de revue d'agent (ADR-018, C12 — la
     maquette porte la revue d'agent en feuille du haut) : l'intention
     déclarée, les lignes du bloc en lecture, la légende des points de
     contrôle, puis les trois décisions — accepter, refuser, revenir au
     point de contrôle d'ouverture. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/intention_agent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/encre"
        android:textSize="14sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/lignes_agent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/encre_douce"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/legende_agent"
        android:textColor="@color/encre_douce"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bouton_accepter_agent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bloc_accepter" />

        <Button
            android:id="@+id/bouton_refuser_agent"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/bloc_refuser" />

        <Button
            android:id="@+id/bouton_revenir_agent"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/agent_revenir" />
    </LinearLayout>
</LinearLayout>
