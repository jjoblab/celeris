<?xml version="1.0" encoding="utf-8"?>
<!-- Le contenu de la feuille de prédiction (F-02, ADR-018) : le rappel
     contextuel en feuille du haut — la description de l'édition
     prédite, la question de l'application explicite (transaction
     annulable), puis les deux décisions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/description_prediction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/encre"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/prediction_question"
        android:textColor="@color/encre_douce"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bouton_prediction_refuser"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel" />

        <Button
            android:id="@+id/bouton_prediction_appliquer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/prediction_appliquer" />
    </LinearLayout>
</LinearLayout>
