<?xml version="1.0" encoding="utf-8"?>
<!-- Le contenu de la feuille de revue du diff (D-12, ADR-018) : les
     lignes du bloc en lecture (+ et -, comme la sortie de l'atelier),
     puis les deux décisions — accepter applique les lignes du bloc,
     refuser les garde anciennes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/lignes_diff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/encre_douce"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bouton_accepter_diff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bloc_accepter" />

        <Button
            android:id="@+id/bouton_refuser_diff"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/bloc_refuser" />
    </LinearLayout>
</LinearLayout>
