<?xml version="1.0" encoding="utf-8"?>
<!-- L'atelier d'édition : barre d'application au nom du fichier et au
     menu d'actions (recherche, plan, débogage, annulations, thème,
     zoom, réglages), scène pleine (EditorView sur sa couche de popups,
     ADR-018 : le plan et la recherche vivent en feuilles) et barre
     d'état en police à chasse fixe. Les encarts système et clavier
     deviennent des marges du chrome (bord à bord, EditorActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/racine_editeur"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barre_editeur"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:menu="@menu/menu_editeur"
            app:navigationContentDescription="@string/action_retour"
            app:navigationIcon="@drawable/ic_retour"
            app:subtitleTextAppearance="@style/TextAppearance.Material3.TitleSmall"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/scene_edition"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <jo.celeris.android.view.EditorView
            android:id="@+id/editeur"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- La couche porte-popups (M7.5, §7) : superposée à l'éditeur
             dans la même fenêtre, elle ne prend jamais le focus — les
             popups s'y posent en coordonnées de scène, l'atelier les
             repositionne au défilement (PIEGE-27). -->
        <jo.celeris.android.widgets.PopupLayer
            android:id="@+id/couche_popups"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- La surimpression de diagnostic (M7.5, §9) : la ligne de
             vérité du rendu — taille, gouttière, images décolorées,
             retenue — posée sur le coin de la scène, verre fumé. -->
        <TextView
            android:id="@+id/surimpression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="#D92E2E32"
            android:elevation="4dp"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#FFE6E6EC"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/barre_etat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/etat_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/encre_douce"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/etat_langue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="monospace"
            android:textColor="@color/encre_douce"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/etat_arrets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="monospace"
            android:textColor="@color/primaire"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
