<?xml version="1.0" encoding="utf-8"?>
<!-- Le contenu de la feuille de recherche (ADR-018, C12) : la barre
     dépliable de l'atelier migre en feuille du bas — le champ, le
     compteur et les sauts y vivent, le moteur reste SearchBarModel.
     Le champ tient le focus (PIEGE-27 ne concerne pas la feuille :
     elle vit hors de la couche). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:boxBackgroundColor="@color/surface_variante"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_recherche">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/champ_recherche"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/indication_recherche"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/compteur_recherche"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="monospace"
        android:minWidth="52dp"
        android:textAlignment="center"
        android:textColor="@color/encre_douce"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/bouton_precedent"
        style="?attr/materialIconButtonStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/action_precedent"
        android:src="@drawable/ic_monter"
        app:iconSize="20dp" />

    <ImageButton
        android:id="@+id/bouton_suivant"
        style="?attr/materialIconButtonStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/action_suivant"
        android:src="@drawable/ic_descendre"
        app:iconSize="20dp" />

    <ImageButton
        android:id="@+id/bouton_fermer_recherche"
        style="?attr/materialIconButtonStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/action_fermer"
        android:src="@drawable/ic_fermer"
        app:iconSize="20dp" />
</LinearLayout>
