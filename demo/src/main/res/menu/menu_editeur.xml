<?xml version="1.0" encoding="utf-8"?>
<!-- Le menu de l'atelier : recherche, plan, débogage et retour à la
     ligne en icônes directes ; TOUT LE RESTE vit derrière la puce de
     débordement — la CARTE du kit du dépôt de départ s'y ouvre (le
     menu système ne s'affiche plus jamais : rangées cliquables du
     verre, fermeture au choix). Le libellé du thème et l'icône de
     débogage sont ajustés à l'exécution (EditorActivity). -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_recherche"
        android:icon="@drawable/ic_recherche"
        android:title="@string/action_recherche"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_plan"
        android:icon="@drawable/ic_plan"
        android:title="@string/action_plan"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_debogage"
        android:icon="@drawable/ic_debogage"
        android:title="@string/action_deboguer"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_retour_ligne"
        android:icon="@drawable/ic_retour_ligne"
        android:title="@string/action_retour_ligne"
        app:showAsAction="always" />

    <!-- La puce de débordement : le design du kit du dépôt de départ
         (la même carte que le menu d'intentions) remplace le menu
         système — les quinze actions repliées y courent. -->
    <item
        android:id="@+id/action_debordement"
        android:icon="@drawable/ic_debordement"
        android:title="@string/action_debordement"
        app:showAsAction="always" />
</menu>
