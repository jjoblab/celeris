<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
          "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
          "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!-- Nominations du plafond relevé (ADR-019, décision du propriétaire du
     2026-11-11) : les bancs nommés ci-dessous vivent sous le plafond
     relevé (800 lignes), hors du plafond standard (600) — jamais hors de
     tout plafond. Chaque nomination porte sa justification. -->
<suppressions>
    <!-- Le banc de la gouttière (ADR-019) : dix-neuf tests d'un seul
         collaborateur partageant leurs appareils (602 lignes) — la
         traîne C13 du volume de tests continue d'y grossir. -->
    <suppress id="PlafondStandard" files="GutterPainterTest\.java"/>
    <!-- Le banc de la spécification de la démonstration (ADR-019,
         nomination du 2026-11-13) : chaque chantier livré y rejoue son
         scénario sur les mêmes appareils (675 lignes) — le banc suit la
         grille, la grille suit les livraisons. -->
    <suppress id="PlafondStandard" files="BancSpecs\.java"/>
    <!-- L'atelier des popups de la démonstration (nomination du
         2026-11-13, la décision du propriétaire : « relever le plafond
         de certains fichiers si nécessaire ») : l'orchestreur câble les
         satellites du chantier — chaque surface réveillée y gagne son
         lien, son serveur et sa palette (612 lignes) ; les satellites
         mêmes (AtelierUsages, AtelierCouleur, DocAncre…) restent sous
         le plafond standard, l'orchestreur seul porte les câbles. -->
    <suppress id="PlafondStandard" files="AtelierPopups\.java"/>
</suppressions>
