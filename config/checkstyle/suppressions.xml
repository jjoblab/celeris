<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
          "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
          "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!-- Nominations du plafond relevé (ADR-019, décision du propriétaire du
     2026-11-11) : les bancs nommés ci-dessous vivent sous le plafond
     relevé (800 lignes), hors du plafond standard (600) — jamais hors de
     tout plafond. Chaque nomination porte sa justification. -->
<suppressions>
    <!-- Le banc de la gouttière (ADR-019) : dix-neuf tests d'un seul
         collaborateur partageant leurs appareils (602 lignes) — la
         traîne C13 du volume de tests continue d'y grossir. -->
    <suppress id="PlafondStandard" files="GutterPainterTest\.java"/>
    <!-- Le banc de la spécification de l'exemplenstration (ADR-019,
         nomination du 2026-11-13) : chaque chantier livré y rejoue son
         scénario sur les mêmes appareils (675 lignes) — le banc suit la
         grille, la grille suit les livraisons. -->
    <suppress id="PlafondStandard" files="BancSpecs\.java"/>
    <!-- L'orchestrateur des popups de l'éditeur (nomination du
         2026-11-13, la décision du propriétaire : « relever le plafond
         de certains fichiers si nécessaire » — la nomination suit le
         renommage du 2026-11-14, l'orchestrateur absorbe l'atelier de
         l'exemplenstration) : il câble les satellites du chantier —
         chaque surface portée y gagne son lien, son serveur et sa
         palette (755 lignes — le port achevé du 2026-11-14 y câble les douze
         satellites : les huit surfaces du feu vert, l'info-bulle et le
         menu d'intentions en satellites, les fournisseurs vivants) ; les satellites mêmes (TypeInfo,
         DocAncre, SelecteurCouleur…) restent sous le plafond
         standard, l'orchestrateur seul porte les câbles. La
         nomination RENFORCÉE du 2026-11-18 (autorisation du
         propriétaire : « si nécessaire je t'autorise à élever le
         plafond — lignes, méthode — de certaines classes ») lui ouvre
         le palier 900 : le constructeur court au coach muet
         (ADR-0022, point 9 de la revue) y passe — 810 lignes, le
         câbleur seul croît, jamais hors de tout plafond. -->
    <suppress checks="FileLength" files="PopupsEditeur\.java"/>
    <suppress id="PlafondStandard" files="PopupsEditeur\.java"/>
    <!-- L'activité d'édition de l'exemplenstration (nomination du
         2026-11-13, la même décision du propriétaire) : le hub câble
         les ateliers à la scène — les surfaces réveillées y gagnent
         leurs événements réels (les annonces de correctifs et de pause
         de débogage y passent, 614 lignes) ; les ateliers mêmes
         restent sous le plafond standard, le hub seul porte la scène. -->
    <suppress id="PlafondStandard" files="EditorActivity\.java"/>
    <!-- La vue d'éditeur (nomination du 2026-11-13, la même décision,
         reprise le 2026-11-18 pour la couche d'intégration ADR-0022
         phase 2) : le hub câble le pipeline de couches, les crochets
         publics et désormais les paires add/remove de la voie 2.0
         (T3 : huit événements multi-abonnés) plus la source unique
         des réglages (T2 : settings() et l'écouteur d'application) —
         chaque surface in-canvas réveillée y gagne sa couche et son
         crochet (933 lignes au chantier B0 phase 2) ; les couches
         memes (ValeursPainter, FantomePainter…) et les porteurs
         (ViewportWatch, RappelsHote…) restent sous le plafond
         standard, le hub seul porte le câblage. -->
    <suppress checks="FileLength" files="EditorView\.java"/>
    <suppress id="PlafondStandard" files="EditorView\.java"/>
    <!-- Le pont de syntaxe (nomination du 2026-11-18, la même décision
         du propriétaire : « relever le plafond de certains fichiers si
         nécessaire ») : les paires add/removePlanListener de la voie
         2.0 (T3) s'y ajoutent au contrat 1.x — le pont porte les deux
         voies le temps du recensement des hôtes (MIGRATION.md § 0.3),
         613 lignes ; les moteurs memes restent sous le plafond
         standard. -->
    <suppress checks="FileLength" files="EditorSyntax\.java"/>
    <suppress id="PlafondStandard" files="EditorSyntax\.java"/>
    <!-- Le banc de la machine à états des popups (nomination du
         2026-11-13, la même décision du propriétaire : « relever le
         plafond de certains fichiers si nécessaire ») : chaque genre
         du chantier y prouve ses régimes — les tables exhaustives
         d'exclusions et de fermetures grandissent à chaque surface
         réveillée (626 lignes) ; la machine même reste sous le
         plafond standard, le banc seul porte les preuves. -->
    <suppress id="PlafondStandard" files="PopupControllerTest\.java"/>
</suppressions>
